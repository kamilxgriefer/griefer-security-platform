# =============================================================================
# GRIEFER — example environment configuration
# =============================================================================
# Copy to `.env` and adjust. NEVER commit a populated `.env`.
# All values below are safe local-development defaults for a synthetic lab.
# =============================================================================

# --- HTTP server -------------------------------------------------------------
# Bind address for the API. Defaults to loopback on purpose: GRIEFER must not
# be exposed on a public interface without authentication (not yet implemented).
# Binding to 0.0.0.0 is allowed but logs a loud startup warning and requires
# GRIEFER_ALLOW_PUBLIC_BIND=true.
GRIEFER_HTTP_ADDR=127.0.0.1:8080
GRIEFER_ALLOW_PUBLIC_BIND=false

# Request handling limits.
GRIEFER_READ_TIMEOUT=10s
GRIEFER_WRITE_TIMEOUT=30s
GRIEFER_IDLE_TIMEOUT=120s
GRIEFER_SHUTDOWN_TIMEOUT=15s
GRIEFER_MAX_REQUEST_BYTES=1048576
GRIEFER_MAX_BATCH_EVENTS=500

# Write-endpoint rate limiting (token bucket, per client IP).
GRIEFER_RATE_LIMIT_RPS=50
GRIEFER_RATE_LIMIT_BURST=100

# --- PostgreSQL --------------------------------------------------------------
# Local development credentials only. Rotate/replace for any shared deployment.
GRIEFER_POSTGRES_DSN=postgres://griefer:griefer_local_dev@localhost:5432/griefer?sslmode=disable
GRIEFER_DB_MAX_OPEN_CONNS=20
GRIEFER_DB_MAX_IDLE_CONNS=5
GRIEFER_DB_CONN_MAX_LIFETIME=30m

# Set to false to run the API on the in-memory store (no PostgreSQL required).
# Useful for tests and quick demos; data is lost on restart.
GRIEFER_STORAGE_POSTGRES=true

# --- NATS JetStream ----------------------------------------------------------
GRIEFER_NATS_URL=nats://localhost:4222
GRIEFER_NATS_STREAM=GRIEFER_EVENTS
GRIEFER_NATS_SUBJECT=griefer.events.v1
# When false the event bus degrades to an in-process channel. Ingestion keeps
# working even if NATS is down (telemetry capture must never fail closed).
GRIEFER_NATS_ENABLED=true

# --- Policy Kernel (OPA) -----------------------------------------------------
GRIEFER_OPA_URL=http://localhost:8181
GRIEFER_OPA_DECISION_PATH=griefer/response/decision
GRIEFER_OPA_TIMEOUT=3s
# Executive actions fail CLOSED when OPA is unreachable. Do not change.
GRIEFER_OPA_FAIL_CLOSED=true

# --- Response engine ---------------------------------------------------------
# v0.1 supports simulation only. `execute` is not implemented and is rejected.
GRIEFER_RESPONSE_MODE=simulate

# --- Observability -----------------------------------------------------------
GRIEFER_LOG_LEVEL=info
GRIEFER_LOG_FORMAT=json
GRIEFER_ENV=local

# --- Console (Next.js) -------------------------------------------------------
# Server-side base URL used by the console to reach the API.
GRIEFER_API_BASE_URL=http://localhost:8080

# --- Secrets -----------------------------------------------------------------
# Placeholders. Every value below is deliberately not a credential: they exist
# so that `docker compose config` can interpolate and so the required set is
# discoverable, and they are shaped to be unusable and obviously fake.
#
# Generate the real ones with `make secrets`, which writes .env.local and puts
# the passwords in ~/.config/griefer/demo-credentials.txt with mode 600. They
# never belong in this file, which is committed.

# Shared between the console and the API — must be identical in both.
#
# Every placeholder in this file contains the marker "run-make-secrets", and
# both the API and the console refuse to start on a secret carrying it. A value
# published in a public repository is not a secret, and a deployment that copies
# this file must fail loudly rather than run on one.
INTERNAL_API_TOKEN=placeholder-run-make-secrets

# Shared between the API and NATS — must be identical in both.
NATS_USER=griefer
NATS_PASSWORD=placeholder-run-make-secrets

# Console session signing key. Must be at least 32 characters or the console
# refuses every request rather than serving incident data behind a weak gate.
#
# This placeholder is deliberately SHORTER than 32 characters. The previous one
# was padded to pass that check, which made a configuration copied from this
# public file into a working deployment signed with a key anybody can read.
DEMO_SESSION_SECRET=placeholder-run-make-secrets

# The administrator account. Required: a deployment with no administrator has
# nobody who can manage it. The salt and hash come from scrypt; these are not.
GRIEFER_ADMIN_USERNAME=admin
GRIEFER_ADMIN_PASSWORD_SALT=placeholder-run-make-secrets
GRIEFER_ADMIN_PASSWORD_HASH=placeholder-run-make-secrets

# The analyst account is optional — a deployment may start with only an
# administrator, who then provisions the rest.
GRIEFER_ANALYST_USERNAME=analyst
GRIEFER_ANALYST_PASSWORD_SALT=
GRIEFER_ANALYST_PASSWORD_HASH=
