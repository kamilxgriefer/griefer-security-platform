# Binaries
#
# These patterns are ANCHORED with a leading slash on purpose. An unanchored
# "griefer-api" matches any path component with that name — including the source
# directory cmd/griefer-api/, which is how the API's entrypoint silently failed
# to be committed the first time.
/bin/
/dist/
/griefer-api
/griefer-seed
*.exe
*.test
*.out

# Go
vendor/
coverage.out
coverage.html

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnpm-store/

# Environment & secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.yaml
secrets.json
credentials.json

# Local state
tmp/
.tmp/
*.log
postgres-data/
nats-data/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
